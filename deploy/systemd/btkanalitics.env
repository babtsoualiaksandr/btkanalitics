# EnvironmentFile для systemd.
#
# Можно использовать напрямую существующий .env проекта:
#   EnvironmentFile=/home/sshbeltelecom/va/btkanalitics/.env
#
# Этот файл оставлен как пример, если вы не хотите ссылаться на .env.

DJANGO_SETTINGS_MODULE=btkanalitics.settings

# --- Telegram Mini App (открыть Django admin во встроенном WebView) ---
# Бот будет строить URL админки как SITE_URL + /admin/
# SITE_URL=https://example.com
# Или можно задать полный URL напрямую:
# ADMIN_WEBAPP_URL=https://example.com/admin/

# Для корректной работы форм/CSRF в WebView (обычно достаточно Lax; secure — для прода)
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Если домен отличается/есть прокси, добавьте origins:
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
