[Unit]
Description=btkanalitics (web + celery worker + celery worker-parser + celery beat)
Wants=btkanalitics-web.service btkanalitics-celery-worker.service btkanalitics-celery-worker-parser.service btkanalitics-celery-beat.service
After=btkanalitics-web.service btkanalitics-celery-worker.service btkanalitics-celery-worker-parser.service btkanalitics-celery-beat.service

[Install]
WantedBy=multi-user.target

