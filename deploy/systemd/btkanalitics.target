[Unit]
Description=btkanalitics (web + celery worker + celery worker-parser + celery beat + telegram bot)
Wants=btkanalitics-web.service btkanalitics-celery-worker.service btkanalitics-celery-worker-parser.service btkanalitics-celery-beat.service btkanalitics-bot.service
After=btkanalitics-web.service btkanalitics-celery-worker.service btkanalitics-celery-worker-parser.service btkanalitics-celery-beat.service btkanalitics-bot.service

[Install]
WantedBy=multi-user.target

